// generated by assets/build_charshape.py from the Weapons Lab research (research/eyes); v1.0 RC3: the jaw points as vertex numbers
// head pitch: the head joint's bind pitch (deg) - which model this is; eye: left eye centre in the head joint's frame
// (+X forward-ish, -Y up, -Z his left; the right eye has +Z); dome: its axis; front[]: how far the body reaches in front
// of Spine_2 (horizontal, metres) at heights -0.40, -0.30 ... +0.30 m from the joint
struct CharShape {
    const char* name;
    float headPitch, headY;     // the head joint's bind pitch (deg) and height (model space)
    float eye[3], eyeR;         // left eye centre (head frame), radius
    float dome[3], capDeg;      // the eye dome's axis (head frame) and how far round it goes
    float skin[3];              // lid colour (the game's closed-eye texture)
    float front[8];             // the torso's reach in front of Spine_2 at heights -0.40 .. +0.30 m (0.10 m steps)
    float halfw[8];             // and its half width there (0: no body measured at that height)
    float thumb[3];             // the left thumb's mesh tip direction in its Thumb_Base joint's frame (the right: negated)
    // the torso as radial profiles in Spine_1's and Spine_2's frames: at heights h0 + i*0.05 along the joint's +X, round its
    // Y/Z plane in 16 steps (angle 0 = +Y), the skin's distance from the axis (0 = no torso there); r: nh x 16, row by row
    float torsoH0[2];
    int torsoNH[2];
    const float* torsoR[2];
    int jawVert[8];             // his chin, jaw and nose (extreme points below the eyes): their vertex numbers in the
    int njaw;                   // player's own <name>_m.p3d - the points are read from it as the game starts (CharJaw)
    int meshVerts;              // that model's vertex count (the numbers are only trusted in a model of this size)
};
// (v1.0 RC3) the jaw points themselves: built from the player's own model as the game starts (drunkbody.inc) - none ship
typedef float JawPt[3];
static const JawPt* CharJaw(const CharShape* s, int* n);
